# 키 이름만 문서화 (값은 커밋 금지 — 쉘 export 또는 비밀 저장소 사용).
GEMINI_API_KEY=
# Supabase 대시보드 → 프로젝트 → Settings → Database → Connection string → URI
LAEEBLY_DB_URL=
PIPELINE_DB_URL=
AI_VIDEO_ROOT=/Users/gimsewon/rhoonart/ai-video

# ─── YouTube 발행 OAuth (채널 매핑은 config/channels.json; 여기엔 비밀값만) ───
# 채널→토큰/프로젝트 매핑은 config/channels.json 이 단일 소스. 토큰은 get_youtube_token.py 가 자동 기록.
# OAuth 클라이언트: gcp_project 값별로 YT_CLIENT_ID_<PROJECT>/YT_CLIENT_SECRET_<PROJECT> 1쌍.
#   2026-07-29 기준 gcp_project 는 머신(구글 계정) 단위 5개 — VES01·CJENM·VES03·VES04·SEAN.
#   ★전역 YT_CLIENT_ID/SECRET 로 폴백하지 않는다 — 짝 키가 없으면 발행이 그 자리에서 멈춘다.
#   (구 P2~P6·DEFAULT 클라이언트는 폐기됨. 남아 있으면 refresh 가 401 unauthorized_client 로 거부된다.)
YT_CLIENT_ID_VES01=
YT_CLIENT_SECRET_VES01=
# YT_CLIENT_ID_CJENM= / _VES03= / _VES04= / _SEAN= ... (담당 머신 것만 있으면 된다)
# 채널별 refresh token: YT_REFRESH_TOKEN_<token_slug> (예: YT_REFRESH_TOKEN_KIKKIK)
#   get_youtube_token.py --client-secret <프로젝트 client_secret.json> --write-env 로 채널마다 발급
# CHANNELS_CONFIG=  # (선택) config/channels.json 경로 오버라이드
