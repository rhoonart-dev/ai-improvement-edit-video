# 키 이름만 문서화 (값은 커밋 금지 — 쉘 export 또는 비밀 저장소 사용).
GEMINI_API_KEY=
# Supabase 대시보드 → 프로젝트 → Settings → Database → Connection string → URI
LAEEBLY_DB_URL=
PIPELINE_DB_URL=
AI_VIDEO_ROOT=/Users/gimsewon/rhoonart/ai-video

# ─── YouTube 발행 OAuth (채널 매핑은 config/channels.json; 여기엔 비밀값만) ───
# 채널→토큰/프로젝트 매핑은 config/channels.json 이 단일 소스. 토큰은 get_youtube_token.py 가 자동 기록.
# OAuth 클라이언트(프로젝트 분리): gcp_project=DEFAULT 는 아래 전역 키, 그 외는 _<PROJECT> 접미사.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# YT_CLIENT_ID_P2= / YT_CLIENT_SECRET_P2= ... (config의 gcp_project 값별로 1쌍)
# 채널별 refresh token: YT_REFRESH_TOKEN_<token_slug> (예: YT_REFRESH_TOKEN_STORYSUNSAK)
#   get_youtube_token.py --client-secret <프로젝트 client_secret.json> --write-env 로 채널마다 발급
# CHANNELS_CONFIG=  # (선택) config/channels.json 경로 오버라이드
